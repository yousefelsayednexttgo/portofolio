# Full public site origin. Update before the production build; no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Choose Resend OR Formspree. Server-only values; never prefix secrets NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
FORMSPREE_FORM_ID=

# Optional durable limit: 5 inquiries per IP per 10 minutes. Configure both.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
